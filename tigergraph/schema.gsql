// TigerGraph Schema for Agentic Fraud Investigation (HHGOA 2026)
// Graph Name: FraudInvestigationGraph

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    created_at DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card_network STRING,
    card_type STRING,
    card_issuer_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    ts DATETIME,
    amount DOUBLE,
    channel STRING,
    product_code STRING,
    risk_score DOUBLE
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_id STRING,
    device_info STRING,
    operating_system STRING,
    browser STRING,
    screen_resolution STRING,
    is_new STRING,
    proxy_status STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain_name STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    country_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    opened_at DATETIME,
    closed_at DATETIME,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX FraudCase (
    PRIMARY_ID case_id STRING,
    status STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    exposure_usd DOUBLE,
    summary STRING,
    stop_reason STRING,
    closed_at DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Edges
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction);

// Historical Case Memory Edges
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

// Agent Dynamic Writeback Edges
CREATE DIRECTED EDGE INVESTIGATES (FROM FraudCase, TO Card);
CREATE DIRECTED EDGE FLAGS (FROM FraudCase, TO Transaction);
CREATE DIRECTED EDGE CONNECTED_DEVICE (FROM FraudCase, TO DeviceProfile);

CREATE GRAPH FraudInvestigationGraph (
    Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase, FraudCase,
    OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT,
    INVOLVES, ON_CARD, CONNECTED_TO, INVESTIGATES, FLAGS, CONNECTED_DEVICE
);
